PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=refugio_conectado

# Obligatorio. El servidor no arranca si falta, tiene menos de 32 caracteres o es un valor de ejemplo.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Bootstrap seguro del primer superadministrador. No uses credenciales demo.
SUPER_ADMIN_EMAIL=superadmin@tuorganizacion.org
SUPER_ADMIN_PASSWORD=

# Solo para `npm run seed` en desarrollo. Si se omiten, se generan al azar.
# DEMO_ADMIN_PASSWORD=clave_temporal_de_desarrollo
# DEMO_USER_PASSWORD=clave_temporal_de_desarrollo

FRONTEND_URL=http://localhost:5173

UPLOAD_MAX_SIZE=5242880

# Google OAuth (mismo Client ID que en el frontend)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com

# Asistente de adopciÃ³n con IA
# OpciÃ³n recomendada (GRATIS): Groq â€” https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# OpciÃ³n de pago: OpenAI â€” https://platform.openai.com/api-keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-tu_clave_openai
# AI_MODEL=gpt-4o-mini

# Solo desarrollo: muestra el token de recuperaciÃ³n de contraseÃ±a en la respuesta (requiere NODE_ENV=development)
