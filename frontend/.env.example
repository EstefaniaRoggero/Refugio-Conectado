# En desarrollo conviene usar la API relativa para evitar conflictos entre
# localhost (IPv6) y 127.0.0.1 (IPv4). En produccion puede ser una URL absoluta.
VITE_API_URL=/api
# Vacío usa automaticamente el mismo origen abierto en el navegador.
VITE_SITE_URL=
# Servicio de geocodificación intercambiable (búsqueda manual del mapa)
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org
VITE_GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
# Opcional: número WhatsApp para enlace wa.me (solo dígitos, con código país)
# Ejemplo ficticio. Reemplazalo por el número real. No es un número real.
# VITE_WHATSAPP_NUMBER=5490000000000
# Opcionales: perfiles oficiales mostrados en el footer
# VITE_INSTAGRAM_URL=https://www.instagram.com/tu_cuenta
# VITE_FACEBOOK_URL=https://www.facebook.com/tu_pagina
# VITE_LINKEDIN_URL=https://www.linkedin.com/company/tu_empresa
